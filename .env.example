# Supabase project settings — https://supabase.com/dashboard/project/_/settings/api
# Safe to expose in the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_, never import from a Client
# Component, never log it. Bypasses Row Level Security entirely — only used
# from trusted server code (e.g. admin scripts), if and when that's needed.
SUPABASE_SERVICE_ROLE_KEY=

# Used by `supabase gen types` / `supabase db push` (npm run db:*) to target
# the right project without hardcoding it in package.json.
SUPABASE_PROJECT_REF=
